# Public, non-secret product configuration. Root deployment uses an empty base path.
NEXT_PUBLIC_APP_NAME=Corporate Network
NEXT_PUBLIC_APP_SHORT_NAME=CN
NEXT_PUBLIC_APP_SUBTITLE=Placement Committee Workspace
NEXT_PUBLIC_APP_TAGLINE=Connect alumni relationships to corporate opportunities.
APP_PUBLIC_URL=https://network.teamsynapse.app
APP_BASE_PATH=/

# Institutional mail identity remains separate from the product brand.
MAIL_SENDER_DISPLAY_NAME=Placement Committee, IIM Lucknow
# Configure only when the institutional mailbox OAuth route is implemented in Stage 2.
MAIL_OAUTH_CALLBACK_URL=

# Keep provider secrets and live gates server-side. Never prefix these with NEXT_PUBLIC_.
# Provider-specific gates permit Coresignal to run live without activating Lusha.
CORESIGNAL_LIVE_ENABLED=false
# Separate, server-only opt-in for Base Employee ES-DSL Search. Keep false until
# an explicitly approved one-request acceptance test.
CORESIGNAL_SEARCH_ENABLED=false
# Separate fail-closed gate for the Base Employee ES-DSL Search Preview path.
# The configured local key completed the controlled 2026-10-19 capability test,
# but this remains false by default so every live session is a deliberate opt-in.
CORESIGNAL_ES_DSL_PREVIEW_ENABLED=false
# Values: unknown, confirmed, not_entitled. Use confirmed only for the tested key
# after reviewing docs/provider-evidence/coresignal-es-dsl-preview-2026-10-19.md.
# Operational access does not establish the provider's exact billing tariff.
CORESIGNAL_ES_DSL_PREVIEW_ENTITLEMENT=unknown
# Independent Base Employee Collect-only gate. Keep disabled until the exact
# retained Search candidate and account Collect entitlement are approved.
CORESIGNAL_COLLECT_ENABLED=false
# Values: unknown, confirmed, not_entitled. Search-credit evidence must not be
# used to infer a Collect allowance.
CORESIGNAL_COLLECT_ENTITLEMENT=unknown
# Local browser acceptance only. Ignored unless the explicit loopback development
# controls, Collect gate, and confirmed entitlement are all active.
CORESIGNAL_COLLECT_MOCK_TRANSPORT=false
# Local-only demo opt-in. The normal `dev:local` command overrides this to false.
LOCAL_CORESIGNAL_LIVE_DEMO_ENABLED=false
LOCAL_CORESIGNAL_LIVE_DEMO_HOST=127.0.0.1
LUSHA_LIVE_ENABLED=false
# Leave these blank until account-specific endpoint access, pricing and caps are verified.
# They reserve INTERNAL application units per one request; they are not provider debit claims.
LUSHA_SEARCH_MAX_APPLICATION_UNITS=
LUSHA_EMAIL_MAX_APPLICATION_UNITS=
LUSHA_PHONE_MAX_APPLICATION_UNITS=
LUSHA_SEARCH_ENTITLEMENT=unknown
LUSHA_EMAIL_ENTITLEMENT=unknown
LUSHA_PHONE_ENTITLEMENT=unknown
LUSHA_ENTITLEMENT_SOURCE=
LUSHA_ENTITLEMENT_VERIFIED_AT=
CORESIGNAL_LIVE_SEARCH_MAX_RESULTS=20
CORESIGNAL_LIVE_REFRESH_MAX_PROFILES=1
LUSHA_SIGNALS_LIVE_ENABLED=false
# Values: unknown, confirmed, not_entitled. Never infer this from ordinary Lusha contact access.
LUSHA_SIGNALS_ENTITLEMENT=unknown
LUSHA_SIGNALS_ENTITLEMENT_VERIFIED_AT=
LUSHA_SIGNALS_ENTITLEMENT_SOURCE=
MAIL_MODE=mock
MAIL_LIVE_ENABLED=false
MAIL_PROVIDER=gmail
MAIL_SENDER_EMAIL=
# Use mailbox-specific Gmail OAuth credentials; do not assume the sign-in client is authorized to send mail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Confirm only after the separate mailbox authorization grants Gmail's gmail.send scope.
GMAIL_SEND_SCOPE_CONFIRMED=false
MAIL_LAST_VALIDATION_STATUS=Not validated
MAIL_LAST_VALIDATED_AT=
MAIL_LAST_VALIDATION_SOURCE=
CORESIGNAL_API_KEY=
LUSHA_API_KEY=

# Bright Data Web Scraper API: one known LinkedIn profile URL per explicitly
# confirmed asynchronous job. These values remain server-only.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_DATASET_ID=
BRIGHTDATA_LIVE_ENABLED=false
BRIGHTDATA_MOCK_TRANSPORT=false
BRIGHTDATA_APPLICATION_REQUEST_LIMIT=5
# Values: unknown, confirmed, not_entitled. A configured token/dataset does not
# prove account access or establish provider billing.
BRIGHTDATA_ACCESS_ENTITLEMENT=unknown
LOCAL_PROVIDER_LIVE_DEMO_ENABLED=false
LOCAL_PROVIDER_LIVE_DEMO_HOST=127.0.0.1

# Stage 2.5 authentication. Secrets remain server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=iiml.ac.in
# Generate at least 32 random characters. Changing this invalidates active app sessions.
AUTH_SESSION_SECRET=

# Comma-separated ChatGPT identities allowed to create the first recovery Admin.
BOOTSTRAP_ADMIN_EMAILS=

# Local server-to-server Alumni Profile Intelligence transport. Never expose
# INTELLIGENCE_SERVICE_SECRET through client-side environment variables.
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:4310
INTELLIGENCE_SERVICE_SECRET=replace-with-the-same-long-local-secret-used-by-the-intelligence-service
