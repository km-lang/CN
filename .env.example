# Public, non-secret product configuration. Root deployment uses an empty base path.
NEXT_PUBLIC_APP_NAME=Corporate Network
NEXT_PUBLIC_APP_SHORT_NAME=CN
NEXT_PUBLIC_APP_SUBTITLE=Placement Committee Workspace
NEXT_PUBLIC_APP_TAGLINE=Connect alumni relationships to corporate opportunities.
APP_PUBLIC_URL=https://network.teamsynapse.app
APP_BASE_PATH=/

# Institutional mail identity remains separate from the product brand.
MAIL_SENDER_DISPLAY_NAME=Placement Committee, IIM Lucknow
# Configure only when the institutional mailbox OAuth route is implemented in Stage 2.
MAIL_OAUTH_CALLBACK_URL=

# Keep provider secrets and live gates server-side. Never prefix these with NEXT_PUBLIC_.
# Provider-specific gates permit Coresignal to run live without activating Lusha.
CORESIGNAL_LIVE_ENABLED=false
# Local-only demo opt-in. The normal `dev:local` command overrides this to false.
LOCAL_CORESIGNAL_LIVE_DEMO_ENABLED=false
LOCAL_CORESIGNAL_LIVE_DEMO_HOST=127.0.0.1
LUSHA_LIVE_ENABLED=false
CORESIGNAL_LIVE_SEARCH_MAX_RESULTS=20
CORESIGNAL_LIVE_REFRESH_MAX_PROFILES=1
LUSHA_SIGNALS_LIVE_ENABLED=false
# Values: unknown, confirmed, not_entitled. Never infer this from ordinary Lusha contact access.
LUSHA_SIGNALS_ENTITLEMENT=unknown
LUSHA_SIGNALS_ENTITLEMENT_VERIFIED_AT=
LUSHA_SIGNALS_ENTITLEMENT_SOURCE=
MAIL_MODE=mock
MAIL_LIVE_ENABLED=false
MAIL_PROVIDER=gmail
MAIL_SENDER_EMAIL=
# Use mailbox-specific Gmail OAuth credentials; do not assume the sign-in client is authorized to send mail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Confirm only after the separate mailbox authorization grants Gmail's gmail.send scope.
GMAIL_SEND_SCOPE_CONFIRMED=false
MAIL_LAST_VALIDATION_STATUS=Not validated
MAIL_LAST_VALIDATED_AT=
MAIL_LAST_VALIDATION_SOURCE=
CORESIGNAL_API_KEY=
LUSHA_API_KEY=

# Stage 2.5 authentication. Secrets remain server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=iiml.ac.in
# Generate at least 32 random characters. Changing this invalidates active app sessions.
AUTH_SESSION_SECRET=

# Comma-separated ChatGPT identities allowed to create the first recovery Admin.
BOOTSTRAP_ADMIN_EMAILS=

# Local server-to-server Alumni Profile Intelligence transport. Never expose
# INTELLIGENCE_SERVICE_SECRET through client-side environment variables.
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:4310
INTELLIGENCE_SERVICE_SECRET=replace-with-the-same-long-local-secret-used-by-the-intelligence-service
